# ── Meta Ads ─────────────────────────────────────────────────────────────────
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxx
META_AD_ACCOUNT_IDS=1234567890,9876543210   # sem "act_", separado por vírgula

# ── Google Ads ────────────────────────────────────────────────────────────────
# Opção 1: arquivo google-ads.yaml no repositório (não commite com segredos!)
GOOGLE_ADS_YAML_PATH=google-ads.yaml
# Opção 2: variáveis individuais aceitas pelo SDK (preencha no workflow)
# GOOGLE_ADS_DEVELOPER_TOKEN=xxx
# GOOGLE_ADS_CLIENT_ID=xxx
# GOOGLE_ADS_CLIENT_SECRET=xxx
# GOOGLE_ADS_REFRESH_TOKEN=xxx
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=xxx   # MCC ID, se aplicável
GOOGLE_ADS_CUSTOMER_IDS=123-456-7890,098-765-4321

# ── LinkedIn Ads ──────────────────────────────────────────────────────────────
LINKEDIN_ACCESS_TOKEN=AQXxxxxxxxxxxxxxxx
LINKEDIN_AD_ACCOUNT_IDS=510123456,510654321

# ── Slack ─────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ── Datas (opcional — padrão: ontem) ─────────────────────────────────────────
# REPORT_DATE_START=2025-05-27
# REPORT_DATE_END=2025-05-27
